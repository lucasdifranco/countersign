# Webhook secret (the same value registered on GitHub). Generate with: openssl rand -hex 32
WEBHOOK_SECRET=
# GitHub token (fine-grained) with access to the REPOS repositories:
#   Contents: read (clone) | Commit statuses: read and write | commit comment write (see README)
GITHUB_TOKEN=

# BYOK: any OpenAI-compatible endpoint (OpenAI, DeepSeek, OpenRouter, Groq, vLLM, a gateway...).
# The same endpoint serves the `ocr` review and the verifier calls.
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_API_KEY=
LLM_MODEL=deepseek-flash
# models.dev provider id, used only to look up the token price (deepseek, openai, anthropic, openrouter...)
LLM_PROVIDER=deepseek
# Optional price override, USD per million tokens. Unset = read from models.dev.
#PRICE_INPUT=0.15
#PRICE_OUTPUT=0.6
#PRICE_CACHE_READ=0.003

# owner/repo separated by commas; a push from another repository is ignored
REPOS=owner/repo
# Host side of the published port. Use 127.0.0.1:<port> when a tunnel in front reaches it locally.
HOST_PORT=8080
# status "failure" from this severity among the confirmed findings: critical | major | minor
GATE=major
# 1 = never call GitHub (status and comment go to the log only)
DRY_RUN=0
# PRs with this base go through the audit (method /audit)
AUDIT_BASE=main
